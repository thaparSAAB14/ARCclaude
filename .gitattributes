# Line endings: LF in the repository, native in the working tree.
# This matches how the repo is already stored, so adding it changes no blobs -
# it just stops Git guessing (and warning) on every commit.
* text=auto

# Windows-native scripts must be CRLF on disk to run reliably.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Visual Studio / .NET add-in sources are CRLF by convention.
*.cs     text eol=crlf
*.csproj text eol=crlf
*.xaml   text eol=crlf
*.daml   text eol=crlf

# Python, docs and config stay LF everywhere.
*.py   text eol=lf
*.pyt  text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Never touch these.
*.png        binary
*.jpg        binary
*.pdf        binary
*.esriAddinX binary
*.qgz        binary
*.tif        binary

# Keep generated/vendored files out of language stats and diffs.
uv.lock      linguist-generated=true -diff
docs/logo.svg linguist-documentation=true
